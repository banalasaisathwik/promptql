# Pooled PostgreSQL URL used by the running FastAPI application.
DATABASE_URL=

# Direct PostgreSQL URL used only by Alembic migration commands.
DATABASE_MIGRATION_URL=

# Dedicated test branch URL used only by opt-in PostgreSQL integration tests.
TEST_DATABASE_URL=
TEST_DATABASE_CONFIRMATION=promptql-test-database

# The deterministic fake remains the default. Live mode requires GITHUB_TOKEN
# and never falls back to fake data after an authentication or network failure.
PROMPTQL_GITHUB_CONNECTOR=fake
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_REQUEST_TIMEOUT_SECONDS=10

# Jira Cloud fixture mode is independent from GitHub mode. Live Jira requires
# an HTTPS *.atlassian.net site, account email, and revocable API token.
PROMPTQL_JIRA_CONNECTOR=fake
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_REQUEST_TIMEOUT_SECONDS=10

# OpenTelemetry is opt-in. Console exporters are useful for local learning;
# production traffic should normally use the provider-neutral OTLP endpoint.
PROMPTQL_TELEMETRY_ENABLED=false
PROMPTQL_TELEMETRY_CONSOLE_ENABLED=false
OTEL_SERVICE_NAME=promptql-api
OTEL_EXPORTER_OTLP_ENDPOINT=
# Example only: Authorization=Basic%20BASE64_INSTANCE_ID_AND_API_TOKEN
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
